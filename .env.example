# Sao chép file này thành .env.local rồi điền giá trị thật (tương đương config.php cũ)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chunorapet_cms
DB_USER=root
DB_PASSWORD=
# MySQL trên cloud cần SSL → 1
DB_SSL=0

# Hash mật khẩu admin: dùng lại đúng chuỗi admin_password_hash trong config.php cũ ($2y$...)
# hoặc tạo mới: node scripts/hash-password.mjs "MAT_KHAU"
ADMIN_PASSWORD_HASH=
# Chuỗi bí mật ký cookie phiên đăng nhập (>= 32 ký tự ngẫu nhiên)
SESSION_SECRET=

# Email thông báo form tư vấn (SMTP)
MAIL_TO=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Telegram báo lead
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Messenger báo lead
FB_PAGE_ACCESS_TOKEN=
FB_ADMIN_PSIDS=
FB_GRAPH_VERSION=v21.0
FB_MESSAGING_TYPE=MESSAGE_TAG
FB_MESSAGE_TAG=CONFIRMED_EVENT_UPDATE

# ===== Chỉ khi deploy Vercel =====
# Tự bật trên Vercel: dữ liệu admin lưu vào MySQL (bảng content_files) thay vì file content/*.json
# CONTENT_STORE=mysql
# Ảnh/video tải lên lưu trên Vercel Blob (Vercel tự thêm biến này khi bạn tạo Blob store và nối vào project)
# BLOB_READ_WRITE_TOKEN=
# Khoá API dịch tự động (tuỳ chọn)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
